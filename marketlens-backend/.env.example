# Copy to .env for local development. On Render, set these in the Environment tab.
# None of these are secret yet; Kalshi's market-data API is public.

# Browser origins allowed to call the API (comma-separated, no wildcard).
ALLOWED_ORIGINS=https://yashgupta0823.github.io,http://localhost:8000,http://127.0.0.1:8000

# Optional tuning (defaults shown).
# KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
# KALSHI_TIMEOUT_SECONDS=6
# MARKETS_CACHE_SECONDS=60
# HISTORY_CACHE_SECONDS=300
# MAX_MARKETS=150
# MAX_MARKETS_PER_EVENT=3
# KALSHI_SERIES=CONTROLH,CONTROLS,KXFEDDECISION,...

# Used by the AI Market Brief in a later step. Never commit a real key.
# OPENAI_API_KEY=
